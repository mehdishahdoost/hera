{
  "name": "hera-agent-cli",
  "version": "0.1.0",
  "description": "Orchestrate local AI agent CLIs",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "hera": "dist/index.js" },
  "files": ["dist", "README.md", "assets/hera-logo.png"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && vitest run",
    "hera": "tsx src/index.ts"
  },
  "dependencies": {
    "commander": "15.0.0",
    "croner": "10.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
